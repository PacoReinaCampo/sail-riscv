// Regression tests for the independent W bank and the supplied opcode table.
$[test]
function test_w_state_and_arithmetic() -> unit = {
  reset();
  w_init_wregs();
  wtype.bits = zeros(); // e8, LMUL=1, undisturbed masks and tails
  wl = to_bits(4);
  w_write_single_element(8, 0, Wregidx(0b00001), 0xFE);
  w_write_single_element(8, 0, Wregidx(0b00010), 0x03);
  w_write_single_element(8, 0, Wregidx(0b00011), 0xAA);
  w_write_single_element(8, 1, Wregidx(0b00011), 0xBB);

  // Wraparound addition; all other banks must be preserved.
  vr3 = ones();
  let other_bank = yr3;
  let result = execute(W_WWTYPE(W_WW_WADD, 0b1, Wregidx(0b00001), Wregidx(0b00010), Wregidx(0b00011)));
  assert(result == RETIRE_SUCCESS);
  assert(w_read_single_element(8, 0, Wregidx(0b00011)) == 0x01);
  assert(vr3 == ones());
  assert(yr3 == other_bank);

  // Masked-off elements and tails are undisturbed.
  wr0 = zeros();
  w_write_single_element(8, 0, Wregidx(0b00011), 0xAA);
  let masked = execute(W_WWTYPE(W_WW_WADD, 0b0, Wregidx(0b00001), Wregidx(0b00010), Wregidx(0b00011)));
  assert(masked == RETIRE_SUCCESS);
  assert(w_read_single_element(8, 0, Wregidx(0b00011)) == 0xAA);

  // wl=0 must not alter the bank.
  wl = zeros();
  let previous = wr3;
  let empty = execute(W_WWTYPE(W_WW_WADD, 0b1, Wregidx(0b00001), Wregidx(0b00010), Wregidx(0b00011)));
  assert(empty == RETIRE_SUCCESS & wr3 == previous);

  // Saturation raises only this bank's sticky saturation flag.
  wl = to_bits(1);
  let saturated = execute(W_WWTYPE(W_WW_WSADDU, 0b1, Wregidx(0b00001), Wregidx(0b00010), Wregidx(0b00011)));
  assert(saturated == RETIRE_SUCCESS);
  assert(w_read_single_element(8, 0, Wregidx(0b00011)) == 0xFF);
  assert(wcsr[wxsat] == 0b1);

  // The coordinate view and flat storage agree at a row boundary.
  if w_columns * 1 < wlen / 8 then {
    w_write_element(8, 1, 0, Wregidx(0b00100), 0x5A);
    assert(w_read_single_element(8, w_columns * 1, Wregidx(0b00100)) == 0x5A)
  };
  w_reset()
}

$[test]
