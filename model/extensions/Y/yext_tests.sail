      (0x4801202b, "yzext.yf8"),
    ];
  foreach (i from 0 to 626) {
    let (word, mnemonic) = cases[i];
    let memory = word[6 .. 0] == 0b0000111 | word[6 .. 0] == 0b0100111;
    if not(memory) | algebra_memory_bank == AlgebraMemory_Y then {
      let decoded = ext_decode(word);
      assert(
        string_startswith(assembly(decoded), mnemonic ^ " "),
        mnemonic ^ ": opcode table mismatch: " ^ assembly(decoded)
      );
      assert(encdec(decoded) == word, mnemonic ^ ": encoding roundtrip failed")
    }
  }
}
