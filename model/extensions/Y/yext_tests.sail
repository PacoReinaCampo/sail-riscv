// Regression tests for the independent Y bank and the supplied opcode table.
$[test]
function test_y_state_and_arithmetic() -> unit = {
  reset();
  y_init_yregs();
  ytype.bits = zeros(); // e8, LMUL=1, undisturbed masks and tails
  yl = to_bits(4);
  y_write_single_element(8, 0, Yregidx(0b00001), 0xFE);
  y_write_single_element(8, 0, Yregidx(0b00010), 0x03);
  y_write_single_element(8, 0, Yregidx(0b00011), 0xAA);
  y_write_single_element(8, 1, Yregidx(0b00011), 0xBB);

  // Wraparound addition; all other banks must be preserved.
  vr3 = ones();
  let other_bank = wr3;
  let result = execute(Y_YYTYPE(Y_YY_YADD, 0b1, Yregidx(0b00001), Yregidx(0b00010), Yregidx(0b00011)));
  assert(result == RETIRE_SUCCESS);
  assert(y_read_single_element(8, 0, Yregidx(0b00011)) == 0x01);
  assert(vr3 == ones());
  assert(wr3 == other_bank);

  // Masked-off elements and tails are undisturbed.
  yr0 = zeros();
  y_write_single_element(8, 0, Yregidx(0b00011), 0xAA);
  let masked = execute(Y_YYTYPE(Y_YY_YADD, 0b0, Yregidx(0b00001), Yregidx(0b00010), Yregidx(0b00011)));
  assert(masked == RETIRE_SUCCESS);
  assert(y_read_single_element(8, 0, Yregidx(0b00011)) == 0xAA);

  // yl=0 must not alter the bank.
  yl = zeros();
  let previous = yr3;
  let empty = execute(Y_YYTYPE(Y_YY_YADD, 0b1, Yregidx(0b00001), Yregidx(0b00010), Yregidx(0b00011)));
  assert(empty == RETIRE_SUCCESS & yr3 == previous);

  // Saturation raises only this bank's sticky saturation flag.
  yl = to_bits(1);
  let saturated = execute(Y_YYTYPE(Y_YY_YSADDU, 0b1, Yregidx(0b00001), Yregidx(0b00010), Yregidx(0b00011)));
  assert(saturated == RETIRE_SUCCESS);
  assert(y_read_single_element(8, 0, Yregidx(0b00011)) == 0xFF);
  assert(ycsr[yxsat] == 0b1);

  // The coordinate view and flat storage agree at a row boundary.
  if y_columns * y_depth < ylen / 8 then {
    y_write_element(8, 1, 0, 0, Yregidx(0b00100), 0x5A);
    assert(y_read_single_element(8, y_columns * y_depth, Yregidx(0b00100)) == 0x5A)
  };
  y_reset()
}

$[test]
function test_y_opcode_specification() -> unit = {
