  let cases : vector(627, (bits(32), string)) = [
      (0x2000202b, "yaaddu.yy"),
      (0x2000602b, "yaaddu.yx"),
      (0x2400202b, "yaadd.yy"),
      (0x2400602b, "yaadd.yx"),
